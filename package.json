{
  "name": "utools-quick-launcher",
  "version": "2.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:preload": "node --check public/preload/services.js",
    "check": "npm run lint && npm run test && npm run check:preload && npm run build",
    "release:check": "npm run check && node scripts/verify-release.mjs"
  },
  "dependencies": {
    "pinyin-pro": "3.29.2",
    "react": "19.2.3",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "27.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "utools-api-types": "7.5.1",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
